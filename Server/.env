# ===============================
# Database Configuration
# ===============================
MONGODB_URI=mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@<CLUSTER_URL>/<DB_NAME>?retryWrites=true&w=majority
DB_NAME=SmartCart
PORT=5000


# ===============================
# Firebase Configuration
# ===============================
FIREBASE_PROJECT_ID=<FIREBASE_PROJECT_ID>


# ===============================
# Cloudinary Configuration
# ===============================
CLOUDINARY_CLOUD_NAME=<CLOUDINARY_CLOUD_NAME>
CLOUDINARY_API_KEY=<CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<CLOUDINARY_API_SECRET>


# ===============================
# Flask ML Service
# ===============================
FLASK_BASE=http://localhost:5001
FLASK_PORT=5001


# ===============================
# Admin Configuration
# ===============================
ADMIN_EMAIL=<ADMIN_EMAIL>
ADMIN_EMAIL_PASS=<ADMIN_EMAIL_APP_PASSWORD>


# ===============================
# Hugging Face AI Models
# ===============================
HF_API_TOKEN=<HF_API_TOKEN>
HF_SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
HF_SUMMARY_MODEL=facebook/bart-large-cnn


# ===============================
# ML Model Path
# ===============================
MODEL_PATH=Server/python_service/final_hybrid_location_recommender.pkl


# ===============================
# WebODM Configuration
# ===============================
WEBODM_URL=http://localhost:8001
WEBODM_USER=<WEBODM_USERNAME>
WEBODM_PASS=<WEBODM_PASSWORD>
WEBODM_PROJECT_ID=6
